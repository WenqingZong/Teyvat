target/
debug/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debug info
*.pdb

# cargo mutants
**/mutants.out*/

# rustc ICE stack traces
rustc-ice-*.txt

# Editors
.idea/
.vscode/

# Python tool caches
.mypy_cache/
.ruff_cache/

# Any temp file during development
tmp/

# Windows download markers (from copying files in via WSL)
*:Zone.Identifier

# AI tooling and state for the nightly test (see AGENTS.md); never reviewed or deployed
.nightly_test/
