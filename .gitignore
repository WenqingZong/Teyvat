# Build output
target/
debug/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debug info
*.pdb

# cargo mutants
**/mutants.out*/

# rustc ICE stack traces
rustc-ice-*.txt

# Editors
.idea/
.vscode/

# Python tool caches
.mypy_cache/
.ruff_cache/

# Any temp file during development
tmp/

# Secrets: never commit. Real configs hold Bark credentials; deploy/*.example.toml are the templates.
api_keys/
phanes.toml
market_data_provider.toml
*.key
*.env

# Windows download markers (from copying files in via WSL)
*:Zone.Identifier

# Reference copies of the old repos' root files, used only while merging
.legacy/
